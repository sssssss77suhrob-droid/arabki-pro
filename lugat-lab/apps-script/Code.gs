-size:13px}.layout{display:grid;grid-template-columns:1fr 290px;gap:25px}.panel{background:#fff;border:1px solid var(--line);border-radius:22px;padding:25px}.toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px}.switch{display:flex;gap:5px;background:#eaece4;padding:5px;border-radius:13px}.switch button{background:none;border:0;padding:9px 15px}.switch .active{background:#fff;box-shadow:0 2px 5px #0001}.progress{height:5px;border-radius:8px;background:#e9ece4;margin:18px 0}.progress div{height:100%;background:#b4c491;border-radius:8px;transition:width .3s}.card{min-height:320px;border:1px solid #dedfce;border-radius:19px;background:#fbfbf5;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:28px;position:relative;touch-action:pan-y;}.word{font-family:'Traditional Arabic','Noto Naskh Arabic',serif;font-size:64px;line-height:1.6;margin:18px 0 3px}.translation{font-size:25px;margin:12px}.tiny{font-size:12px;color:var(--muted)}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.spread{justify-content:space-between}.actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0}.known{background:#e5eedd;border-color:#d8e2cf}.unknown{background:#f9eee7;border-color:#ebddd2}.side-title{font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted)}.metric{font:38px Georgia,serif;margin:14px 0 5px}.rule{border-top:1px solid var(--line);margin:24px 0}.tip{font-size:13px;line-height:1.8;color:var(--muted)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.form-grid label{display:grid;gap:8px}.deck{padding:22px;border:1px solid var(--line);border-radius:17px;background:#fff;margin:14px 0}.deck h3{margin:0 0 8px}.feedback{padding:13px;border-radius:10px;margin:12px 0;background:#edf3e7}.bad{background:#fff0e9;color:#984b39}.hidden{display:none!important}.forms{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:18px}.forms span{background:#edf0e7;padding:9px 14px;border-radius:8px}.forms b{display:block;font:27px serif;margin-top:6px}.toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:#183d36;color:white;border-radius:14px;padding:15px 24px;z-index:10;max-width:90%}footer{text-align:center;color:var(--muted);padding:25px;font-size:12px}.answer{width:100%;text-align:center;font-size:22px;margin-top:15px}.status{font-size:12px;color:var(--muted);margin-top:10px}dialog{border:1px solid var(--line);border-radius:22px;max-width:650px;width:95%;padding:25px}dialog::backdrop{background:#17382a66}@keyframes enter{from{opacity:.1;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}@media(max-width:760px){header{padding:15px 20px}.tag.header-tag{display:none}nav button{padding:8px}main{padding:25px 16px}.hero{align-items:start}h1{font-size:34px}.hero .badge{display:none}.layout{grid-template-columns:1fr}.sidebar{display:none}.panel{padding:17px}.word{font-size:55px}.form-grid{grid-template-columns:1fr}.toolbar{gap:8px}.card{min-height:300px}}\n\n.card-scene{perspective:1400px;animation:enter .26s ease}\n.card{display:grid;padding:0;background:transparent;border:0;transform-style:preserve-3d;transition:transform .6s cubic-bezier(.2,.7,.2,1)}\n.card.flipped{transform:rotateY(180deg)}\n.card-face{grid-area:1/1;min-width:0;min-height:320px;border:1px solid #dedfce;border-radius:19px;background:#fbfbf5;padding:28px;display:flex;flex-direction:column;justify-content:center;align-items:center;backface-visibility:hidden;-webkit-backface-visibility:hidden;overflow-wrap:anywhere}\n.card-back{transform:rotateY(180deg);background:#eff3e8}\n.accepted{max-width:100%;margin:12px 0;line-height:1.7;color:#637464;font-size:13px}\n@media(max-width:760px){.card-face{padding:22px 16px;min-height:300px}}\n@media(prefers-reduced-motion:reduce){.card,.card-scene,button,.progress div{transition:none;animation:none}}\n</style></head><body><header><div class=\"logo\"><span>ل</span>Lug‘at Lab</div><nav><button onclick=\"show('study')\">Mashq</button><button onclick=\"show('library')\">To‘plamlar</button><button onclick=\"show('create')\">＋ Yaratish</button></nav><div class=\"tag header-tag\">BIR SO‘Z. YANGI IMKONIYAT.</div></header><main><div class=\"hero\"><div><div class=\"tag\">ARAB TILI • SHAXSIY LUG‘ATINGIZ</div><h1>Bilim, bir so‘zdan boshlanadi.</h1><p>Yodlang. Yozing. Takrorlang. O‘z sur’atingizda.</p></div><span class=\"badge\">✦ Har kuni kichik bir qadam</span></div><div id=\"connection\" class=\"status\"></div><section id=\"study\"><div class=\"layout\"><div class=\"panel\"><div class=\"toolbar\"><div class=\"switch\"><button id=\"flashTab\" onclick=\"setMode('flash')\">Flashcard</button><button id=\"writeTab\" onclick=\"setMode('write')\">Yozma imtihon</button></div><select aria-label=\"Savol yo‘nalishi\" id=\"direction\" onchange=\"changeDirection()\"><option value=\"ar\">Arabcha → O‘zbekcha</option><option value=\"uz\">O‘zbekcha → Arabcha</option><option value=\"mixed\">Aralash yo‘nalish</option></select></div><div class=\"row spread\"><strong id=\"deckTitle\"></strong><label class=\"tiny\"><input type=\"checkbox\" id=\"auto\" onchange=\"audioPreference()\"> Avto talaffuz</label></div><div class=\"progress\"><div id=\"bar\"></div></div><div class=\"row spread tiny\" style=\"margin-bottom:15px\"><span id=\"counter\"></span><span id=\"hint\"></span></div><div id=\"exercise\"></div><div class=\"row spread\"><button id=\"prev\" onclick=\"move(-1)\">← Oldingi</button><button onclick=\"shuffleCurrent()\">⤨ Aralashtirish</button><button id=\"next\" onclick=\"move(1)\">Keyingi →</button></div></div><aside class=\"panel sidebar\"><div class=\"side-title\">BUGUNGI MASHQ</div><div class=\"metric\" id=\"total\">0</div><div class=\"tiny\">ta so‘z bilan bir qadam oldinga</div><div class=\"rule\"></div><div class=\"row spread\"><span>✓ Bilaman</span><strong id=\"yesCount\">0</strong></div><br><div class=\"row spread\"><span>↺ Takrorlayman</span><strong id=\"noCount\">0</strong></div><div class=\"rule\"></div><div class=\"side-title\">KICHIK MASLAHAT</div><p class=\"tip\">Javobni ochishdan oldin so‘zni ovoz chiqarib ayting. Eslashga urinishning o‘zi ham o‘rganishdir.</p><p class=\"tip\">← Bilmayman &nbsp; • &nbsp; Bilaman →<br>Bo‘sh joy — kartani ochish</p><button style=\"width:100%\" onclick=\"finish()\">Natijani ko‘rish</button></aside></div><div class=\"row\" style=\"margin-top:16px\"><button onclick=\"askSaveName()\">Saqlash</button><button onclick=\"download(mode)\">↓ HTML yuklab olish</button><button onclick=\"finish()\">Mashqni yakunlash</button></div></section><section id=\"library\" class=\"hidden\"><div class=\"toolbar\"><h2>Saqlangan to‘plamlar</h2><button class=\"primary\" onclick=\"show('create')\">＋ Yangi to‘plam</button></div><div class=\"row\"><button onclick=\"mixAll('flash')\">⤨ Barchasidan flashcard</button><button onclick=\"mixAll('write')\">⤨ Barchasidan yozma</button></div><div id=\"decks\"></div></section><section id=\"create\" class=\"hidden panel\"><h2>Yangi lug‘at to‘plami</h2><p>Oddiy so‘zlarni yoki fe’lning to‘rt shaklini yuboring. Shakllar bitta kartaga jamlanadi, asosiy so‘z — muzori’. Bir nechta to‘g‘ri tarjimani «;» bilan ajrating.</p><div class=\"form-grid\"><label>To‘plam nomi<input id=\"name\" placeholder=\"Masalan: 1-dars · Kundalik hayot\" maxlength=\"80\"></label><label>Mashq turi<select id=\"newMode\"><option value=\"flash\">HTML · Flashcard</option><option value=\"write\">HTML · Yozma imtihon</option></select></label></div><details style=\"margin:16px 0\"><summary>Kiritish namunalari</summary><p class=\"tiny\">To‘rt shakl: كَتَبَ / يَكْتُبُ / اُكْتُبْ / كِتَابَةٌ — yozmoq<br><br>Yoki alohida satrlarda:<br>Tarjima: yozmoq<br>Moziy: كَتَبَ<br>Muzori’: يَكْتُبُ<br>Amr: اُكْتُبْ<br>Masdar: كِتَابَةٌ<br><br>Oddiy: كِتَابٌ — kitob<br>Ot: كِتَابٌ | kitob | noun | كُتُبٌ<br>Fe’l: يَكْتُبُ | yozmoq | verb | كَتَبَ | يَكْتُبُ | اُكْتُبْ | كِتَابَةٌ | أَكْتُبُ</p></details><textarea id=\"words\" aria-label=\"Lug‘atlar\" placeholder=\"كِتَابٌ — kitob&#10;قَلَمٌ — qalam&#10;أكتب — yozmoq\"></textarea><div class=\"row\" style=\"margin-top:15px\"><label><input type=\"checkbox\" id=\"ai\"> AI bilan shakllarni to‘ldirish (ulangan botda)</label><button class=\"primary\" id=\"generate\" onclick=\"createDeck()\">To‘plamni yaratish →</button></div><p id=\"createStatus\" role=\"status\"></p></section><section id=\"results\" class=\"hidden panel\"></section></main><footer>Lug‘at Lab · O‘rganishga mehr bilan &nbsp; / &nbsp; Talaffuz qurilmangizdagi ovozlarga bog‘liq.</footer><dialog id=\"saveDialog\"><h2>To‘plam tayyor</h2><p>HTML faylini yuklab olib, to‘plamni keyingi mashqlar uchun saqlashingiz mumkin.</p><div class=\"row\"><button class=\"primary\" onclick=\"askSaveName()\">Saqlash</button><button onclick=\"download(mode)\">↓ HTML yuklash</button><button onclick=\"document.getElementById('saveDialog').close()\">Hozircha saqlamaslik</button></div></dialog><dialog id=\"nameDialog\" aria-labelledby=\"nameHeading\"><form onsubmit=\"event.preventDefault();saveCurrent()\"><h2 id=\"nameHeading\">Qanday nom bilan saqlaymiz?</h2><label for=\"saveName\">To‘plam nomi</label><input id=\"saveName\" style=\"display:block;width:100%;margin:12px 0\" maxlength=\"80\" required placeholder=\"Masalan: 2-dars · Fe’llar\"><p class=\"tiny\">HTML fayli va saqlangan to‘plam shu nomda bo‘ladi.</p><p id=\"saveError\" role=\"alert\"></p><div class=\"row\"><button id=\"confirmSave\" type=\"submit\" class=\"primary\">Nom bilan saqlash</button><button type=\"button\" onclick=\"document.getElementById('nameDialog').close()\">Bekor qilish</button></div></form></dialog><script id=\"embedded\" type=\"application/json\">null</script><script>\nconst $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst sample=[{\"ar\":\"يَكْتُبُ\",\"uz\":\"yozmoq\",\"type\":\"verb\",\"past\":\"كَتَبَ\",\"present\":\"يَكْتُبُ\",\"imperative\":\"اُكْتُبْ\",\"masdar\":\"كِتَابَةٌ\",\"first\":\"أَكْتُبُ\",\"gloss_forms\":[\"yozmoq\",\"yozdi\",\"yozadi\",\"yozyapti\",\"yozmoqda\",\"yozish\",\"yoz\",\"yozaman\"]},{\"ar\":\"كِتَابٌ\",\"uz\":\"kitob\",\"type\":\"noun\",\"plural\":\"كُتُبٌ\"},{\"ar\":\"يَقْرَأُ\",\"uz\":\"o‘qimoq\",\"type\":\"verb\",\"past\":\"قَرَأَ\",\"present\":\"يَقْرَأُ\",\"imperative\":\"اِقْرَأْ\",\"masdar\":\"قِرَاءَةٌ\",\"first\":\"أَقْرَأُ\",\"gloss_forms\":[\"o‘qimoq\",\"o‘qidi\",\"o‘qiydi\",\"o‘qiyapti\",\"o‘qimoqda\",\"o‘qish\",\"o‘qi\",\"o‘qiyman\"]},{\"ar\":\"قَلَمٌ\",\"uz\":\"qalam\",\"type\":\"noun\",\"plural\":\"أَقْلَامٌ\"},{\"ar\":\"بَيْتٌ\",\"uz\":\"uy\",\"type\":\"noun\",\"plural\":\"بُيُوتٌ\"},{\"ar\":\"يَذْهَبُ\",\"uz\":\"bormoq\",\"type\":\"verb\",\"past\":\"ذَهَبَ\",\"present\":\"يَذْهَبُ\",\"imperative\":\"اِذْهَبْ\",\"masdar\":\"ذَهَابٌ\",\"first\":\"أَذْهَبُ\",\"gloss_forms\":[\"bormoq\",\"bordi\",\"boradi\",\"boryapti\",\"bormoqda\",\"borish\",\"bor\",\"boraman\"]},{\"ar\":\"صَدِيقٌ\",\"uz\":\"do‘st\",\"type\":\"noun\",\"plural\":\"أَصْدِقَاءُ\"},{\"ar\":\"جَمِيلٌ\",\"uz\":\"chiroyli\",\"type\":\"noun\",\"plural\":\"جَمِيلُونَ\"}];\nlet saved=[];try{saved=JSON.parse(localStorage.getItem('lugatDecks')||'[]')}catch{}const embedded=JSON.parse($('embedded').textContent);let current=embedded||{id:'sample',name:'Birinchi qadam · Kundalik so‘zlar',mode:'flash',words:sample},mode=current.mode||'flash',queue=[],pos=0,answers={},flipped=false,side='ar',remote=false,initData='',view='study';\nfunction toast(s){const e=document.createElement('div');e.className='toast';e.setAttribute('role','status');e.textContent=s;document.body.append(e);setTimeout(()=>e.remove(),4000)}\nfunction norm(s){return s.normalize('NFKC').replace(/[\\u0610-\\u061a\\u064b-\\u065f\\u0670\\u06d6-\\u06ed\\u0640]/g,'').toLowerCase().replace(/[‘’ʻʼ`]/g,\"'\").trim().replace(/\\s+/g,' ')}\n// Derive only third-person positive present variants; keep other persons and negation distinct.\nfunction uzNorm(value){return norm(value).replace(/[.!?]+$/u,'').trim()}\nfunction isPresentVerb(w){\n  if(w.type==='verb'&&w.present&&norm(w.ar)===norm(w.present))return true;\n  return sample.some(k=>k.type==='verb'&&norm(k.ar)===norm(w.ar)&&uzNorm(k.uz)===uzNorm(w.uz));\n}\nfunction acceptedUz(w){\n  const bases=w.uz.split(/[;/]/).map(uzNorm).filter(Boolean);\n  const result=new Set([...bases,...(Array.isArray(w.accepted_uz)?w.accepted_uz.map(uzNorm):[])]);\n  if(isPresentVerb(w))for(const base of bases){\n    if(!base.endsWith('moq'))continue;\n    const stem=base.slice(0,-3);if(!stem)continue;\n    const variants=[stem+(/[aeiou]$/u.test(stem)?'ydi':'adi'),stem+'yapti',stem+'moqda'];\n    for(const v of variants){result.add(v);result.add('u '+v)}\n  }\n  return [...result];\n}\nfunction isCorrect(w,value,direction){\n  return direction==='ar'?acceptedUz(w).includes(uzNorm(value)):w.ar.split(/[;/]/).some(x=>norm(x)===norm(value));\n}\nfunction shuffle(a){for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}\nasync function api(path,options={}){const r=await fetch('/api'+path,{...options,headers:{'Content-Type':'application/json','X-Telegram-Init-Data':initData,...options.headers}});if(!r.ok){let msg='Server xatosi';try{msg=(await r.json()).detail||msg}catch{}throw Error(msg)}return r.json()}\nasync function init(){if(location.protocol!=='file:'){const s=document.createElement('script');s.src='https://telegram.org/js/telegram-web-app.js';s.onload=async()=>{initData=window.Telegram?.WebApp?.initData||'';window.Telegram?.WebApp?.ready();if(initData){try{saved=await api('/decks');remote=true;$('connection').textContent='● Telegram bilan sinxronlangan'}catch(e){toast(e.message)}}};document.head.append(s)}$('connection').textContent='Qurilmadagi rejim · To‘plamlar shu brauzerda saqlanadi. Telegram sinxronlash bot ulanganda ishlaydi.';try{$('auto').checked=localStorage.getItem('autoAudio')==='true'}catch{}reset()}\nfunction show(v){view=v;['study','library','create','results'].forEach(x=>$(x).classList.toggle('hidden',x!==v));if(v==='library')renderLibrary()}\nfunction reset(){queue=current.words.map((w,i)=>({...w,key:i}));pos=0;answers={};flipped=false;show('study');render()}\nfunction setMode(m){mode=m;flipped=false;answers={};pos=0;render()}\nfunction changeDirection(){flipped=false;answers={};render()}\nfunction render(){\n if(!queue.length)return;\n const w=queue[pos];side=$('direction').value;if(side==='mixed')side=pos%2?'uz':'ar';\n $('deckTitle').textContent=current.name;$('counter').textContent=`${pos+1} / ${queue.length} so‘z`;\n $('hint').textContent=mode==='flash'?'Kartani oching va o‘zingizni baholang':'Javobni yozing · Harakatlar ixtiyoriy';\n $('bar').style.width=((pos+1)/queue.length*100)+'%';\n $('flashTab').classList.toggle('active',mode==='flash');$('writeTab').classList.toggle('active',mode==='write');\n $('total').textContent=queue.length;updateCounts();$('prev').disabled=pos===0;\n $('next').textContent=pos===queue.length-1?'Natija →':'Keyingi →';\n const a=answers[w.key],target=side==='ar'?'uz':'ar';\n const aliases=side==='ar'?acceptedUz(w).filter(x=>!x.startsWith('u ')&&!w.uz.split(/[;/]/).map(uzNorm).includes(x)):[];\n $('exercise').innerHTML=`<div class=\"card-scene\"><div class=\"card${flipped?' flipped':''}\" id=\"card\">\n <div class=\"card-face card-front\" id=\"frontFace\" aria-hidden=\"${flipped}\" ${flipped?'inert':''}>\n <div class=\"tag\">${side==='ar'?'MA’NOSINI ESLANG':'ARABCHASINI ESLANG'}</div>\n <div class=\"${side==='ar'?'word':'translation'}\" dir=\"${side==='ar'?'rtl':'ltr'}\">${esc(w[side])}</div>\n <button aria-label=\"Talaffuzni eshitish\" onclick=\"speak()\">◖)) Talaffuz</button>\n ${mode==='flash'?'<button id=\"frontFlip\" style=\"margin-top:20px\" onclick=\"flip()\">Javobni ko‘rish ↻</button>':`<form style=\"width:100%\" onsubmit=\"event.preventDefault();check()\"><input id=\"answer\" class=\"answer\" autocomplete=\"off\" dir=\"${side==='ar'?'ltr':'rtl'}\" placeholder=\"${side==='ar'?'O‘zbekcha javob…':'اكتب هنا…'}\" aria-label=\"Javob\" value=\"${esc(a?.value||'')}\"><button class=\"primary\" style=\"margin-top:12px\" type=\"submit\">Tekshirish</button></form><div id=\"feedback\" aria-live=\"polite\"></div>`}\n </div>\n <div class=\"card-face card-back\" id=\"backFace\" aria-hidden=\"${!flipped}\" ${!flipped?'inert':''}>\n <div class=\"tag\">TO‘G‘RI JAVOB</div><div class=\"${target==='ar'?'word':'translation'}\" dir=\"${target==='ar'?'rtl':'ltr'}\">${esc(w[target])}</div>\n ${aliases.length?`<div class=\"accepted\">Bu javoblar ham to‘g‘ri: ${aliases.map(esc).join(' · ')}</div>`:''}\n <button onclick=\"speak()\" aria-label=\"Arabcha talaffuzni eshitish\">◖)) Talaffuz</button>\n ${details(w)}<button id=\"backFlip\" style=\"margin-top:20px\" onclick=\"flip()\">↶ Savolga qaytish</button>\n </div></div></div>\n ${mode==='flash'?'<div class=\"actions\"><button class=\"unknown\" onclick=\"grade(false)\">← Bilmayman</button><button class=\"known\" onclick=\"grade(true)\">Bilaman ✓ →</button></div>':'<div style=\"height:18px\"></div>'}`;\n if(mode==='write'&&a)feedback(a);\n let x=null;\n $('card').onpointerdown=e=>{x=e.target.closest('button,input,select,textarea')?null:e.clientX};\n $('card').onpointerup=e=>{if(x!==null&&mode==='flash'&&Math.abs(e.clientX-x)>75)grade(e.clientX>x);x=null};\n $('card').onpointercancel=()=>{x=null};\n if($('auto').checked&&side==='ar')speak();\n}\nfunction updateCounts(){\n $('yesCount').textContent=Object.values(answers).filter(x=>x.ok).length;\n $('noCount').textContent=Object.values(answers).filter(x=>!x.ok).length;\n}\nfunction details(w){return `<div class=\"row\" style=\"justify-content:center;margin-top:12px\">${w.type==='verb'?'<button onclick=\"revealForms()\">Moziy · Muzori’ · Amr · Masdar</button><button onclick=\"revealFirst()\">Men shakli</button>':'<button onclick=\"revealPlural()\">Ko‘plik</button>'}</div><div id